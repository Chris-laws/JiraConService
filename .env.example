# Kopieren nach .env (wird nicht eingecheckt). Echte Umgebungsvariablen haben Vorrang.
REQPILOT_DATA_SOURCE=mock      # mock | live
REQPILOT_LLM=fake              # fake | vertex | gemini
REQPILOT_JIRA_WRITE_ENABLED=false
# REQPILOT_DOCS_DIR=/pfad/zu/docs   # Change Log, Anleitungen, Schulungen als .md (Standard: fixtures/docs)

# Empfohlen: Gemini über Vertex AI mit OAuth-Token, kein API-Key.
# Lokal vorher einmal: gcloud auth application-default login
VERTEX_PROJECT_ID=              # Projekt-ID mit Bindestrichen, nicht die Nummer
VERTEX_LOCATION=global          # oder z. B. europe-west3
GEMINI_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-multilingual-embedding-002
# Auf Databricks statt gcloud-Login: Service-Account-JSON als Secret
VERTEX_SERVICE_ACCOUNT_JSON=

# Nur falls die Gemini-API mit Key freigegeben ist (bei uns bisher nicht):
GEMINI_API_KEY=

JIRA_URL=
JIRA_PAT=
CONFLUENCE_URL=
CONFLUENCE_PAT=
CONFLUENCE_SPACES=ADF
SERVICENOW_URL=
SERVICENOW_TOKEN=
